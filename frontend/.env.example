# Vite embeds these public addresses in the browser bundle at build time. Never
# put passwords or secret keys in a VITE_ variable because users can inspect it.
# A same-origin production deployment may leave both values unset. The browser
# then uses HTTPS and secure WebSockets on the host that served the frontend.
VITE_API_BASE_URL=http://localhost:4000
VITE_WS_BASE_URL=ws://localhost:4000
