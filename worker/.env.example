# Manual worker-development values. Do not commit a real worker/.env file.
APP_ENV=development
# For the hybrid setup, replace this with the online broker addresses.
KAFKA_BROKERS=localhost:9092
# Keep PLAINTEXT locally; use the online provider's SSL or SASL_SSL setting.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Hosted Kafka commonly requires these three SASL values. Leave them commented
# for the local broker because it does not have authentication enabled.
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=replace_with_kafka_username
# KAFKA_SASL_PASSWORD=replace_with_kafka_password
# Optional path for a broker using a private certificate authority.
# KAFKA_SSL_CA_PATH=/absolute/path/to/kafka-ca.pem
KAFKA_JOB_CREATED_TOPIC=audio.jobs.created
KAFKA_JOB_STATUS_TOPIC=audio.jobs.status
KAFKA_CONSUMER_GROUP=audio-worker
KAFKA_DEAD_LETTER_TOPIC=audio.jobs.dead-letter
MAX_PROCESSING_ATTEMPTS=3
RETRY_BACKOFF_SECONDS=5
JOB_LEASE_TIMEOUT_SECONDS=300
# Heartbeats must be more frequent than the lease timeout above.
JOB_HEARTBEAT_INTERVAL_SECONDS=30
# This second heartbeat reports whether the worker process itself is alive,
# including while it is idle and therefore owns no job lease.
WORKER_HEARTBEAT_INTERVAL_SECONDS=15
WORKER_STALE_AFTER_SECONDS=60

# An online production URL must include ?sslmode=require or a stricter mode.
DATABASE_URL=postgresql://audio_user:replace_with_local_password@localhost:5432/audio_processing

# An online production endpoint must begin with https://.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_local_access_key
S3_SECRET_ACCESS_KEY=replace_with_local_secret_key
S3_BUCKET=audio-processing

# demucs runs real ML separation; mock exercises infrastructure with text files.
PROCESSING_MODE=demucs
DEMUCS_MODEL=htdemucs_6s
# Total duration of the mock progress loop. Demucs mode ignores this value.
MOCK_PROCESSING_DELAY_SECONDS=3.5

# Completed and failed job files remain private and downloadable for seven days.
RESULT_RETENTION_HOURS=168
