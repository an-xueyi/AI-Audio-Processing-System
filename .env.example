# Copy this template to .env for Docker Compose. Replace every placeholder;
# the real .env is gitignored because it contains local credentials.
APP_ENV=development

POSTGRES_USER=audio_user
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=audio_processing

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=replace_with_a_local_password
# The browser must be able to reach this address in a presigned URL.
S3_PUBLIC_ENDPOINT=http://localhost:9000

# SESSION_SECRET signs browser cookies and must be long, random, and private.
SESSION_SECRET=replace_with_at_least_32_random_characters
# Production replaces this with the public HTTPS application origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false

# Terminal job audio is deleted after this many hours. Seven days = 168 hours.
RESULT_RETENTION_HOURS=168
# Cleanup checks a bounded number of expired jobs once per minute.
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=25
CLEANUP_CLAIM_TIMEOUT_MINUTES=15

# Demucs is the real processing mode. Temporarily change this to mock when
# testing several local worker replicas without loading several ML models.
PROCESSING_MODE=demucs
DEMUCS_MODEL=htdemucs_6s
MOCK_PROCESSING_DELAY_SECONDS=3.5
