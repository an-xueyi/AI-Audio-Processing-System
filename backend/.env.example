# Manual backend-development values. Docker Compose provides container-specific
# equivalents automatically when the complete system runs in Docker.
APP_ENV=development
PORT=4000

DATABASE_URL=postgresql://audio_user:replace_with_local_password@localhost:5432/audio_processing

S3_ENDPOINT=http://localhost:9000
# Signed URLs contain this browser-reachable endpoint.
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_local_access_key
S3_SECRET_ACCESS_KEY=replace_with_local_secret_key
S3_BUCKET=audio-processing

# A comma-separated list supports one local broker or several managed brokers.
KAFKA_BROKERS=localhost:9092
# Local Kafka is plaintext. A hosted broker should normally use SASL_SSL.
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# Set the following only when the chosen Kafka service requires SASL.
# KAFKA_SASL_MECHANISM=SCRAM-SHA-256
# KAFKA_SASL_USERNAME=replace_with_kafka_username
# KAFKA_SASL_PASSWORD=replace_with_kafka_password
# Set this only for a broker whose TLS certificate uses a private authority.
# KAFKA_SSL_CA_PATH=/run/secrets/kafka-ca.pem
KAFKA_JOB_CREATED_TOPIC=audio.jobs.created
KAFKA_JOB_STATUS_TOPIC=audio.jobs.status
KAFKA_STATUS_CONSUMER_GROUP_PREFIX=audio-backend-status
OUTBOX_PUBLISH_INTERVAL_MS=500

SESSION_SECRET=replace_with_at_least_32_random_characters
# Comma-separate multiple frontend origins when needed.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Change to true only when the browser reaches the backend through HTTPS.
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=262144000

# Storage lifecycle settings used by cancellations and the cleanup process.
RESULT_RETENTION_HOURS=168
CLEANUP_INTERVAL_SECONDS=60
CLEANUP_BATCH_SIZE=25
CLEANUP_CLAIM_TIMEOUT_MINUTES=15
