PORT=4000

DATABASE_URL=postgresql://audio_user:replace_with_local_password@localhost:5432/audio_processing

S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=replace_with_local_access_key
S3_SECRET_ACCESS_KEY=replace_with_local_secret_key
S3_BUCKET=audio-processing

KAFKA_BROKER=localhost:9092
KAFKA_JOB_CREATED_TOPIC=audio.jobs.created

SESSION_SECRET=replace_with_at_least_32_random_characters
CORS_ALLOWED_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
MAX_UPLOAD_BYTES=262144000
