{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // Tests import production modules but should never create files in dist.
    "rootDir": ".",
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
